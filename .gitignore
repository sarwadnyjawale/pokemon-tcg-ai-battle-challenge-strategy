# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/
build/
dist/

# ---------------------------------------------------------------------------
# Competition data policy.
#  - The two small card-dataset CSVs ARE committed (tiny, ~360KB each) so the
#    test suite is self-contained; they are the reprodu:cible input set.
#  - The 131MB card-ID PDF is competition data + exceeds GitHub's 100MB blob
#    limit, so it is NEVER committed and must be re-obtained from Kaggle.
#    See docs/DATASET.md.
#  - data/raw and data/processed are regenerated by the phase1 pipeline.
# ---------------------------------------------------------------------------
data/*.pdf
data/raw/
data/processed/

# ---------------------------------------------------------------------------
# Derived experiment artifacts stay local. Only curated final-submission
# evidence is committed (see docs/REPRODUCIBILITY.md).
# ---------------------------------------------------------------------------
results/*
!results/final_submission/
!results/final_submission/**

# Figure outputs (rendered PNGs) are generated, not source.
figures/

# Secrets are never committed.
*.env
.env
